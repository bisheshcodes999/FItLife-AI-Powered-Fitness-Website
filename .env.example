# Copy this file to .env and fill in your own values. NEVER commit .env.

# Email (Gmail app password: Google Account -> Security -> App passwords)
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_app_password

# Django
DJANGO_SECRET_KEY=generate_a_long_random_string_here
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=

# Local AI (Ollama) for meal recommendations & AI coach
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
